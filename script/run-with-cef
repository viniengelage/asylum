#!/bin/bash
# Runs Zed with CEF framework available for Web Preview
set -e

# Find the CEF directory from the build artifacts
CEF_DIR=$(find target/debug/build/cef-dll-sys-*/out/cef_macos_aarch64 -maxdepth 0 2>/dev/null | head -1)

if [ -z "$CEF_DIR" ]; then
    echo "CEF not found. Building web_preview first..."
    cargo build -p web_preview
    CEF_DIR=$(find target/debug/build/cef-dll-sys-*/out/cef_macos_aarch64 -maxdepth 0 2>/dev/null | head -1)
fi

if [ -z "$CEF_DIR" ]; then
    echo "ERROR: CEF framework not found after build. Check build logs."
    exit 1
fi

echo "Using CEF from: $CEF_DIR"

export CEF_PATH="$CEF_DIR"
export DYLD_FALLBACK_LIBRARY_PATH="${DYLD_FALLBACK_LIBRARY_PATH:+$DYLD_FALLBACK_LIBRARY_PATH:}$CEF_DIR:$CEF_DIR/Chromium Embedded Framework.framework/Libraries"

# Run Zed
exec cargo run "$@"
